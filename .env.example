# OpenRouter (default LLM provider). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Optional: override the default model
# OPENROUTER_MODEL=qwen/qwen3.5-9b

# Optional: route to a self-hosted Ollama instead of OpenRouter.
# If OLLAMA_URL is set, OpenRouter is ignored.
# OLLAMA_URL=http://100.106.166.101:11434/api/generate
# OLLAMA_MODEL=qwen3.5:9b
